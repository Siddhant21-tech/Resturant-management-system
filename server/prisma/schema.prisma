generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id        String      @id @default(uuid())
  name      String
  slug      String      @unique
  logoUrl   String?
  taxRate   Float       @default(5.0) // GST / Sales Tax %
  currency  String      @default("₹")
  createdAt DateTime    @default(now())
  branches  Branch[]
  users     User[]
  auditLogs AuditLog[]
}

model Branch {
  id              String           @id @default(uuid())
  restaurantId    String
  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name            String
  address         String?
  phone           String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  users           User[]
  tables          Table[]
  kitchenStations KitchenStation[]
  menuCategories  MenuCategory[]
  menuItems       MenuItem[]
  diningSessions  DiningSession[]
  auditLogs       AuditLog[]
}

model KitchenStation {
  id          String      @id @default(uuid())
  branchId    String
  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name        String      // "Main Kitchen", "Bar", "Dessert", "Grill"
  colorCode   String      @default("#f97316")
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  menuItems   MenuItem[]
  orderItems  OrderItem[]
}

model Table {
  id               String          @id @default(uuid())
  branchId         String
  branch           Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  number           String          // e.g. "T-01", "T-15"
  capacity         Int             @default(4)
  zone             String          @default("Main Dining") // "Indoor", "Patio", "VIP"
  status           String          @default("AVAILABLE")   // "AVAILABLE", "OCCUPIED", "BILL_REQUESTED"
  currentSessionId String?
  createdAt        DateTime        @default(now())
  diningSessions   DiningSession[]
}

model User {
  id           String       @id @default(uuid())
  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name         String
  email        String       @unique
  role         String       // "PLATFORM_ADMIN", "RESTAURANT_ADMIN", "MANAGER", "CASHIER", "WAITER", "KITCHEN_STAFF"
  pinCode      String       @default("1234")
  avatar       String?
  createdAt    DateTime     @default(now())
  sessions     DiningSession[]
  auditLogs    AuditLog[]
}

model MenuCategory {
  id        String     @id @default(uuid())
  branchId  String
  branch    Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int        @default(0)
  items     MenuItem[]
}

model MenuItem {
  id          String          @id @default(uuid())
  branchId    String
  branch      Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  categoryId  String
  category    MenuCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float
  imageUrl    String?
  isVeg       Boolean         @default(true)
  isAvailable Boolean         @default(true)
  stationId   String?
  station     KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  orderItems  OrderItem[]
  billItems   BillItem[]
}

model DiningSession {
  id          String       @id @default(uuid())
  branchId    String
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tableId     String
  table       Table        @relation(fields: [tableId], references: [id], onDelete: Cascade)
  waiterId    String?
  waiter      User?        @relation(fields: [waiterId], references: [id], onDelete: SetNull)
  sessionCode String       // e.g. "S-10045"
  guestCount  Int          @default(2)
  status      String       @default("ACTIVE") // "ACTIVE", "BILL_REQUESTED", "COMPLETED", "CANCELLED"
  startedAt   DateTime     @default(now())
  closedAt    DateTime?
  orders      OrderRound[]
  bills       Bill[]
}

model OrderRound {
  id          String      @id @default(uuid())
  sessionId   String
  session     DiningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  roundNumber Int         @default(1)
  source      String      @default("WAITER") // "WAITER", "CUSTOMER_QR", "POS"
  status      String      @default("SUBMITTED") // "SUBMITTED", "ACCEPTED", "IN_PREPARATION", "READY", "SERVED", "CANCELLED"
  notes       String?
  submittedAt DateTime    @default(now())
  acceptedAt  DateTime?
  items       OrderItem[]
}

model OrderItem {
  id          String          @id @default(uuid())
  roundId     String
  round       OrderRound      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  menuItemId  String
  menuItem    MenuItem        @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  stationId   String?
  station     KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  quantity    Int             @default(1)
  unitPrice   Float
  notes       String?
  status      String          @default("PENDING") // "PENDING", "ACCEPTED", "PREPARING", "READY", "SERVED", "CANCELLED"
  acceptedAt  DateTime?
  preparedAt  DateTime?
  createdAt   DateTime        @default(now())
}

model Bill {
  id             String           @id @default(uuid())
  sessionId      String
  session        DiningSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  version        Int              @default(1)
  invoiceNumber  String           // e.g. "INV-000152"
  subtotal       Float            @default(0)
  taxAmount      Float            @default(0)
  discountAmount Float            @default(0)
  finalAmount    Float            @default(0)
  status         String           @default("UNPAID") // "UNPAID", "PAID", "VOIDED"
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  items          BillItem[]
  adjustments    BillAdjustment[]
  payments       Payment[]
}

model BillItem {
  id         String   @id @default(uuid())
  billId     String
  bill       Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  quantity   Int
  unitPrice  Float
  totalPrice Float
}

model BillAdjustment {
  id        String   @id @default(uuid())
  billId    String
  bill      Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  type      String   // "DISCOUNT", "ITEM_MODIFICATION", "VOID"
  userId    String
  reason    String
  oldValue  String
  newValue  String
  createdAt DateTime @default(now())
}

model Payment {
  id              String   @id @default(uuid())
  billId          String
  bill            Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount          Float
  method          String   // "CASH", "UPI", "CARD"
  referenceNumber String?
  receivedByUserId String?
  status          String   @default("SUCCESS")
  createdAt       DateTime @default(now())
}

model AuditLog {
  id           String      @id @default(uuid())
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  action       String
  detailsJson  String      // JSON stringified payload
  createdAt    DateTime    @default(now())
}
